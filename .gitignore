# --- Game data, and anything that contains the game's code: never commit ---
*.chd
*.iso
*.cso
*.pbp
# Linux tells upper from lower case, Windows doesn't: the patterns above miss GAME.ISO here
*.[cC][hH][dD]
*.[iI][sS][oO]
*.[cC][sS][oO]
*.[pP][bB][pP]
*.[pP][rR][xX]
EBOOT.BIN
*_EBOOT.BIN
image.bin
PIC1.PNG
ICON0.PNG
ms0/
re/dumps/
re/out/recomp/*.bin
re/out/*.vfpu.tsv
build/
# Your own discs go in roms/<game>/ (roms/README.txt): git keeps only the folders and their notes
roms/**
!roms/*/
!roms/README.txt
!roms/LEEME.txt
!roms/*/README.txt
!roms/*/LEEME.txt

# Ghidra project (holds the complete analyzed programs)
re/ghidra/

# Third-party reference sources (PPSSPP, GPL); fetch again with the commands in README.md
re/ppsspp-hle/
re/ppsspp-mips/
re/ppsspp-gpu/
re/ppsspp-audio/

# Progress screenshots and gameplay recordings (they show the game's imagery)
media/

# Tooling
.venv/
__pycache__/
*.pyc

# Analysis logs
re/out/*.log
re/out/*.console.txt
